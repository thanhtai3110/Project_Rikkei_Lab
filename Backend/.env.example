# Sao chép thành .env rồi điền thông tin trên máy của bạn. KHÔNG đưa .env lên GitHub.
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/job_portal
JOB_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Gmail SMTP: bật xác minh 2 bước và tạo Mật khẩu ứng dụng.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD
SMTP_FROM=your-email@gmail.com
